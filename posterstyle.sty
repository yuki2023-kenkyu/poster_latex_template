% A0 portrait poster style: beamer + beamerposter + biblatex + LuaLaTeX
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{posterstyle}[2026/11/18 Compact A0 portrait poster style]
\RequirePackage{etoolbox}
\RequirePackage{xfp}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{fontspec}
% Standard \label entries are recorded for \zcref by zref-clever's label hook.
\RequirePackage{zref-clever}

% ---- Reproducible, TeX Live-shipped fonts (English only) ----
% Replace these two lines if your design requires different fonts.
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\usefonttheme{professionalfonts}
\renewcommand{\familydefault}{\sfdefault}

% ---- Color presets (navy emulates the provided dark header/footer) ----
\ifdefstring{\PosterColorTheme}{navy}{%
  \definecolor{PosterAccent}{HTML}{10283D}%
  \definecolor{PosterAccentPale}{HTML}{E9EFF5}%
  \definecolor{PosterMuted}{HTML}{617487}%
}{%
  \ifdefstring{\PosterColorTheme}{forest}{%
    \definecolor{PosterAccent}{HTML}{234D45}%
    \definecolor{PosterAccentPale}{HTML}{EDF4F0}%
    \definecolor{PosterMuted}{HTML}{667870}%
  }{%
    \ifdefstring{\PosterColorTheme}{slate}{%
      \definecolor{PosterAccent}{HTML}{38465C}%
      \definecolor{PosterAccentPale}{HTML}{F1F2F5}%
      \definecolor{PosterMuted}{HTML}{707A88}%
    }{%
      \PackageError{posterstyle}{Unknown color theme '\PosterColorTheme'}{Use navy, forest, or slate in poster-config.tex.}%
    }%
  }%
}%
\definecolor{PosterText}{HTML}{252C34}
\definecolor{PosterRule}{HTML}{66717A}
\colorlet{PosterSectionRule}{PosterAccent}% Consistent regular/alert section dividers
\definecolor{PosterFeaturedBand}{HTML}{DFE9F3}% Pale navy publication strip
\definecolor{PosterFigurePale}{HTML}{F6F7F8}

% ---- Font level presets ----
\ifdefstring{\PosterFontLevel}{compact}{\def\PosterFontScale{0.90}}{%
  \ifdefstring{\PosterFontLevel}{standard}{\def\PosterFontScale{1.00}}{%
    \ifdefstring{\PosterFontLevel}{large}{\def\PosterFontScale{1.10}}{%
      \PackageError{posterstyle}{Unknown font level '\PosterFontLevel'}{Use compact, standard, or large in poster-config.tex.}%
    }%
  }%
}%
% Values are actual printed points at scale=1.0 in beamerposter.
% The second argument specifies leading / font size (e.g., 1.225 = 49/40).
\newcommand{\PosterSetFontRatio}[2]{%
  \fontsize{\fpeval{#1*\PosterFontScale}pt}{\fpeval{#1*#2*\PosterFontScale}pt}\selectfont%
}
\newcommand{\PosterNumberFont}{\PosterSetFontRatio{\PosterNumberPt}{1.19}}
\newcommand{\PosterTitleFont}{\PosterSetFontRatio{\PosterTitlePt}{1.05}\bfseries}
\newcommand{\PosterPresenterFont}{\PosterSetFontRatio{\PosterPresenterPt}{1.08}\bfseries}
\newcommand{\PosterCoauthorFont}{\PosterSetFontRatio{\PosterCoauthorPt}{1.10}}
\newcommand{\PosterAffiliationFont}{\PosterSetFontRatio{\PosterAffiliationPt}{1.10}}
\newcommand{\PosterBlockTitleFont}{\PosterSetFontRatio{\PosterBlockTitlePt}{1.18}\bfseries}
% The existing PosterBodyFont remains the Abstract-body font.
\newcommand{\PosterBodyFont}{\PosterSetFontRatio{\PosterBodyPt}{1.225}}
\newcommand{\PosterSectionBodyFont}{\PosterSetFontRatio{\PosterSectionBodyPt}{1.225}}
% List labels and equation numbers follow their current content region.
% The local binding is changed only inside normal/alerted Section bodies.
\let\PosterActiveBodyFont\PosterBodyFont
\newcommand{\PosterCaptionFont}{\PosterSetFontRatio{\PosterCaptionPt}{1.22}}
\newcommand{\PosterReferenceFont}{\PosterSetFontRatio{\PosterReferencePt}{1.26}}
\newcommand{\PosterFeaturedPaperFont}{\PosterSetFontRatio{\PosterFeaturedPaperPt}{1.20}}
\newcommand{\PosterFooterFont}{\PosterSetFontRatio{\PosterFooterPt}{1.25}}
\newcommand{\PosterPlaceholderFont}{\PosterSetFontRatio{\PosterAffiliationPt}{1.20}}

% ---- Beamer typography and section dividers ----
\setbeamersize{text margin left=\PosterMargin,text margin right=\PosterMargin}
\setbeamertemplate{navigation symbols}{}
% APS/PRD captions: FIG. 1. / TABLE I.
% Single-line captions are centered. Multi-line captions align all lines
% at the FIG./TABLE label's start. Section bodies provide the shared inset;
% captions must not add it again.
\renewcommand{\thetable}{\Roman{table}}
% Preserve uppercase TABLE when babel initializes its English caption names.
% APS guide: TABLE I. and FIG. 1. (uppercase name, trailing periods).
% Babel may reset names; define both in its English caption setup.
\addto\captionsenglish{%
  \renewcommand{\tablename}{TABLE}%
  \renewcommand{\figurename}{FIG.}%
}
% Measure the full caption for one-line centering. Long captions use
% ordinary paragraph alignment inside the shared content width.
\newsavebox{\PosterCaptionLabelBox}
\newsavebox{\PosterCaptionFullBox}
\defbeamertemplate{caption}{poster-prd}{%
  \begingroup
  \usebeamerfont*{caption}%
  \usebeamercolor[fg]{caption}%
  \sbox{\PosterCaptionLabelBox}{%
    \usebeamercolor[fg]{caption name}\usebeamerfont*{caption name}%
    \insertcaptionname~\insertcaptionnumber
    \usebeamertemplate{caption label separator}\space}%
  \sbox{\PosterCaptionFullBox}{%
    \usebox{\PosterCaptionLabelBox}\insertcaption}%
  \centering
  \begin{minipage}{\linewidth}%
    \ifdim\wd\PosterCaptionFullBox<\linewidth
      \centering\usebox{\PosterCaptionFullBox}\par
    \else
      % Normal paragraph wrapping begins at FIG./TABLE, not caption text.
      \noindent\usebox{\PosterCaptionLabelBox}\insertcaption\par
    \fi
  \end{minipage}\par
  \endgroup
}
\setbeamertemplate{caption label separator}[period]
\setbeamertemplate{caption}[poster-prd]
\setbeamerfont{caption}{size=\PosterCaptionFont}
% subfig is optional. Use parenthesized subfigure references and center
% each subcaption within its own subfloat width, including wrapped lines.
\AtBeginDocument{%
  \@ifpackageloaded{subfig}{%
    \renewcommand{\thesubfigure}{(\alph{subfigure})}%
    \DeclareCaptionFont{postersub}{\PosterCaptionFont}%
    \captionsetup[subfloat]{%
      font=postersub,format=plain,labelformat=simple,
      justification=centering,singlelinecheck=true}%
  }{}%
}
% Use the normal text color for PRD-like captions instead of muted gray.
\setbeamercolor{caption}{fg=PosterText}
\setbeamercolor{caption name}{fg=PosterText}
% Native table/tabular rules. Lengths belong to poster-config.tex;
% this local hook avoids altering unrelated tabular environments.
\AtBeginEnvironment{table}{%
  \setlength{\arrayrulewidth}{\PosterTableRuleWidth}%
  \setlength{\doublerulesep}{\PosterTableDoubleRuleSep}%
}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamercolor{normal text}{fg=PosterText,bg=white}
% Keep all three Beamer list levels aligned with the surrounding body font.
\setbeamerfont{itemize/enumerate body}{size=\PosterActiveBodyFont}
\setbeamerfont{itemize/enumerate subbody}{size=\PosterActiveBodyFont}
\setbeamerfont{itemize/enumerate subsubbody}{size=\PosterActiveBodyFont}
\setbeamercolor{itemize/enumerate body}{fg=PosterText}
\setbeamercolor{itemize/enumerate subbody}{fg=PosterText}
\setbeamercolor{itemize/enumerate subsubbody}{fg=PosterText}
\setbeamercolor{structure}{fg=PosterAccent}
\setbeamercolor{itemize item}{fg=PosterAccent}
\setbeamercolor{itemize subitem}{fg=PosterAccent}
\setbeamercolor{itemize subsubitem}{fg=PosterAccent}
\setbeamercolor{enumerate item}{fg=PosterAccent}
\setbeamercolor{enumerate subitem}{fg=PosterAccent}
\setbeamercolor{enumerate subsubitem}{fg=PosterAccent}
% Beamer's enumerate labels have separate fonts/templates from the list body.
% Render ordinary, legible numeric labels in the same size as body text.
\setbeamertemplate{enumerate items}[default]
\setbeamerfont{enumerate item}{size=\PosterActiveBodyFont}
\setbeamerfont{enumerate subitem}{size=\PosterActiveBodyFont}
\setbeamerfont{enumerate subsubitem}{size=\PosterActiveBodyFont}
% Inline/display mathematics (including \bm) inherit their text color.
\setbeamercolor{math text}{}
\setbeamercolor{math text inlined}{parent=math text}
\setbeamercolor{math text displayed}{parent=math text}
% amsmath resets display-equation tags to \normalsize via \normalfont.
% In beamerposter this is much smaller than the content-region body font.
% Keep native equation/align numbering; adjust only the tag's font size.
\makeatletter
\patchcmd{\maketag@@@}{\normalfont}{\normalfont\PosterActiveBodyFont}{}{%
  \PackageError{posterstyle}{Cannot set equation-tag font size}{%
    Check compatibility with the installed amsmath package.}%
}
\makeatother
\setbeamercolor{block title}{fg=PosterAccent,bg=white}
\setbeamercolor{block body}{fg=PosterText,bg=white}
\setbeamercolor{block title alerted}{fg=PosterAccent,bg=PosterAccentPale}
\setbeamercolor{block body alerted}{fg=PosterText,bg=PosterAccentPale}
\setbeamercolor{alerted text}{fg=PosterAccent}
\setbeamerfont{normal text}{size=\PosterBodyFont}
\setbeamerfont{block title}{size=\PosterBlockTitleFont}
\setbeamerfont{block body}{size=\PosterSectionBodyFont}
\setbeamerfont{block title alerted}{size=\PosterBlockTitleFont}
\setbeamerfont{block body alerted}{size=\PosterSectionBodyFont}
\setbeamertemplate{itemize item}{\raisebox{0.10ex}{\textbullet}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.24em}

% Native Beamer section counter, native block and alertblock environments.
% Section headings and zref-clever use the same uppercase Roman numbering.
\renewcommand{\thesection}{\Roman{section}}
% Use a separate value for zref-clever references only. Subfigure captions
% and ordinary \ref retain their existing parenthesized numbering.
\def\PosterSubfigureCounter{subfigure}
\zref@newprop{posterref}{%
  \ifx\@currentcounter\PosterSubfigureCounter
    \thefigure\nobreakspace\thesubfigure
  \else
    \@currentlabel
  \fi
}
\zref@addprop\ZREF@mainlist{posterref}
\zcsetup{cap,abbrev,ref=posterref}

% Beamer inserts an empty zero-height paragraph box when a Section starts
% with a list. Remove it only for an outermost first list. Do not alter
% actual text boxes, nested lists, later lists, or \itemsep.
% The hook is local to each beamercolorbox body.
\makeatletter
\newbox\PosterInitialListBox
\newcommand{\PosterFixInitialList}{%
  \ifnum\@listdepth=\@ne
    \ifnum\lastnodetype=\@ne
      \setbox\PosterInitialListBox=\lastbox
      \ifdim\wd\PosterInitialListBox=\hsize
        \ifdim\dimexpr\ht\PosterInitialListBox+\dp\PosterInitialListBox\relax=\z@
          \@topsep\z@
          \prevdepth=-1000pt\relax
        \else
          \nointerlineskip\box\PosterInitialListBox
        \fi
      \else
        \nointerlineskip\box\PosterInitialListBox
      \fi
    \fi
  \fi
}
\makeatother

% Shared heading geometry: explicit vertical rule avoids an extra font-sized
% baseline between the heading and its separator line.
\newcommand{\PosterHeadingRule}{%
  \par\vskip\PosterTitleRuleGap
  {\color{PosterSectionRule}\hrule height \PosterSectionRuleWidth}%
}

% Regular section: centered heading and full-width rule. The inner body box
% applies the shared inset to paragraphs, lists, figures, and captions.
\defbeamertemplate{block begin}{poster-ruled}{%
  \par\vspace{\PosterSectionTopGap}%
  \begin{beamercolorbox}[wd=\linewidth,sep=0pt]{block title}%
    \centering\usebeamerfont{block title}\insertblocktitle\par
    \PosterHeadingRule
  \end{beamercolorbox}%
  \vspace{\PosterRuleBodyGap}%
  \begin{beamercolorbox}[wd=\linewidth,sep=0pt]{block body}%
    \hspace*{\PosterCaptionHorizontalInset}%
    \begin{minipage}{\dimexpr\linewidth-2\PosterCaptionHorizontalInset\relax}%
    \let\PosterActiveBodyFont\PosterSectionBodyFont
    \usebeamerfont{block body}%
    \expandafter\let\csname beamer@firstlineitemizeunskip\endcsname\PosterFixInitialList%
}
\defbeamertemplate{block end}{poster-ruled}{%
    \end{minipage}%
  \end{beamercolorbox}%
  \par\vspace{\PosterSectionBottomGap}%
}
\setbeamertemplate{block begin}[poster-ruled]
\setbeamertemplate{block end}[poster-ruled]

% Highlighted section: same typography/rule geometry and full-width pale
% background. The inner body shares the regular section's text margins.
\defbeamertemplate{block alerted begin}{poster-highlight}{%
  \par\vspace{\PosterSectionTopGap}%
  \begin{beamercolorbox}[wd=\linewidth,sep=\PosterHighlightPadding]{block title alerted}%
    \centering\usebeamerfont{block title alerted}\insertblocktitle\par
    \PosterHeadingRule
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=\linewidth,sep=\PosterHighlightPadding]{block body alerted}%
    \hspace*{\dimexpr\PosterCaptionHorizontalInset-\PosterHighlightPadding\relax}%
    \begin{minipage}{\dimexpr\linewidth-2\PosterCaptionHorizontalInset\relax}%
    \let\PosterActiveBodyFont\PosterSectionBodyFont
    \usebeamerfont{block body alerted}%
    \expandafter\let\csname beamer@firstlineitemizeunskip\endcsname\PosterFixInitialList%
}
\defbeamertemplate{block alerted end}{poster-highlight}{%
    \end{minipage}%
  \end{beamercolorbox}%
  \par\vspace{\PosterSectionBottomGap}%
}
\setbeamertemplate{block alerted begin}[poster-highlight]
\setbeamertemplate{block alerted end}[poster-highlight]

% ---- Biblatex citation style: italic journal and et al.; bold volume ----
% The featured Reference strip is unbracketed. In-section citations keep [].
\DefineBibliographyStrings{english}{%
  andothers = {{\mkbibemph{et\addabbrvspace al\adddot}}}%
}
\DeclareNameFormat{posterfamily}{%
  \nameparts{#1}%
  \usebibmacro{name:family}
    {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}%
  \usebibmacro{name:andothers}%
}
\DeclareFieldFormat{posterjournal}{\mkbibemph{#1}}
\DeclareFieldFormat{postervolume}{\mkbibbold{#1}}
\DeclareFieldFormat{posterpages}{#1}% No page prefix for poster citations.
\DeclareFieldFormat{postereprint}{#1}% Raw identifier (no automatic arXiv or subject suffix).
\newbibmacro*{poster:publication}{%
  \printnames[posterfamily]{labelname}%
  \setunit{\addcomma\space}%
  \iffieldundef{shortjournal}
    {\printfield[posterjournal]{journaltitle}}
    {\printfield[posterjournal]{shortjournal}}%
  \setunit{\addspace}%
  \printfield[postervolume]{volume}%
  \setunit{\addcomma\space}%
  \iffieldundef{eid}{\printfield[posterpages]{pages}}{\printfield{eid}}%
  \setunit{\addspace}%
  \printtext[parens]{\printfield{year}}%
}
% The featured Reference line reads every name and the eprint from .bib.
% Use given-family (e.g. "Yuki Hashimoto"), preserving the .bib author order.
\DeclareNameFormat{posterfullnames}{%
  \nameparts{#1}%
  \usebibmacro{name:given-family}
    {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}%
}
\newbibmacro*{poster:publication-full}{%
  \printnames[posterfullnames][1-99]{author}%
  \setunit{\addcomma\space}%
  \iffieldundef{shortjournal}
    {\printfield[posterjournal]{journaltitle}}
    {\printfield[posterjournal]{shortjournal}}%
  \setunit{\addspace}%
  \printfield[postervolume]{volume}%
  \setunit{\addcomma\space}%
  \iffieldundef{eid}{\printfield[posterpages]{pages}}{\printfield{eid}}%
  \setunit{\addspace}%
  \printtext[parens]{\printfield{year}}%
  \iffieldundef{eprint}{}{%
    \setunit{\addspace}%
    \printtext[brackets]{%
      % BibLaTeX maps legacy archivePrefix/primaryClass to
      % eprinttype/eprintclass via Biber. The type may be arXiv or arxiv.
      \ifboolexpr{%
        test {\iffieldequalstr{eprinttype}{arxiv}} or
        test {\iffieldequalstr{eprinttype}{arXiv}}%
      }{%
        % Only the arXiv identifier is clickable, not the class or brackets.
        \href{https://arxiv.org/abs/\thefield{eprint}}{%
          arXiv:\printfield[postereprint]{eprint}}%
        % Literal [] prevents nested BibLaTeX brackets becoming parentheses.
        \iffieldundef{eprintclass}{}{[\thefield{eprintclass}]}%
      }{%
        % Do not fabricate an arXiv link for other eprint types.
        \iffieldundef{eprinttype}{}{\printfield{eprinttype}\addcolon}%
        \printfield[postereprint]{eprint}%
      }%
    }%
  }%
}
\DeclareCiteCommand{\postercitebare}
  {} {\usebibmacro{poster:publication-full}} {\addsemicolon\space} {}
% Inline standard \cite{key} with an arXiv link around the entire
% rendered citation when the .bib entry contains an arXiv eprint.
% For entries without an arXiv identifier, keep plain text (no fake link).
% Each entry has its own link, including when citing multiple keys.
\newbibmacro*{poster:cite-entry}{%
  \iffieldundef{eprint}
    {\printtext[brackets]{\usebibmacro{poster:publication}}}
    {\iffieldundef{eprinttype}
      {\href{https://arxiv.org/abs/\thefield{eprint}}{%
         \printtext[brackets]{\usebibmacro{poster:publication}}}}
      {\iffieldequalstr{eprinttype}{arxiv}
        {\href{https://arxiv.org/abs/\thefield{eprint}}{%
           \printtext[brackets]{\usebibmacro{poster:publication}}}}
        {\printtext[brackets]{\usebibmacro{poster:publication}}}}}%
}
\DeclareCiteCommand{\cite}
  {\begingroup\PosterReferenceFont\color{PosterMuted}}
  {\usebibmacro{poster:cite-entry}}
  {\addsemicolon\space}
  {\endgroup}

% ---- Tight navy header, number/Reference optional ----
\newcommand{\PosterHeaderLogo}[1]{%
  \IfFileExists{\PosterLogoFile}{%
    \includegraphics[width=#1,height=\PosterLogoMaxHeight,keepaspectratio]{\PosterLogoFile}%
  }{%
    {\color{white}\fbox{\parbox[c][50mm][c]{#1}{\centering University logo}}}%
  }%
}
% Balance the visible right text stack against the left number/logo group.
% When the poster number is hidden, the previous text spacing is unchanged.
\newcommand{\PosterHeaderTextGap}[1]{%
  \ifPosterShowNumber
    \vspace{\dimexpr#1+\PosterHeaderRightBalanceGap\relax}%
  \else
    \vspace{#1}%
  \fi
}
\newcommand{\PosterHeader}{%
  \begin{tikzpicture}[remember picture,overlay]%
    \fill[PosterAccent] (current page.north west) rectangle
      ([yshift=-\PosterHeaderMainHeight]current page.north east);%
    \ifPosterShowReference
      \fill[PosterFeaturedBand] ([yshift=-\PosterHeaderMainHeight]current page.north west) rectangle
        ([yshift=-\PosterHeaderBandHeight]current page.north east);%
    \fi
    \ifPosterShowNumber\else
      % With number hidden, center the logo in the left navy header region.
      \node[anchor=center,inner sep=0pt] at
        ([xshift=\dimexpr\PosterMargin+0.1125\textwidth\relax,
          yshift=-0.5\PosterHeaderMainHeight]current page.north west) {%
        \PosterHeaderLogo{0.225\textwidth}%
      };%
    \fi
  \end{tikzpicture}%
  \begin{columns}[t,totalwidth=\textwidth]
    \begin{column}{0.225\textwidth}
      \begin{minipage}[t][\PosterHeaderContentHeight][t]{\linewidth}%
        \ifPosterShowNumber
          \vspace*{\dimexpr-\PosterNumberBoxGrow-\PosterHeaderLeftRaise\relax}%
          {\setlength{\fboxsep}{0pt}%
           \noindent\colorbox{white}{%
             \parbox[c][\dimexpr\PosterNumberBoxHeight+\PosterNumberBoxGrow\relax][c]{\linewidth}{%
               \centering\PosterNumberFont\bfseries\color{black}%
               Poster No.:\ \PosterNumber\par}%
           }\par}%
          \vspace{\PosterNumberLogoGap}%
          \noindent\makebox[\linewidth][c]{\PosterHeaderLogo{\linewidth}}%
        \else
          % Only the centered overlay logo is rendered.
          \null
        \fi
      \end{minipage}%
    \end{column}
    \begin{column}{0.755\textwidth}
      \begin{minipage}[t][\PosterHeaderContentHeight][t]{\linewidth}%
        \ifPosterShowNumber
          \vspace*{-\dimexpr\PosterRightContentRaise+\PosterHeaderRightBalanceRaise\relax}%
        \else
          \vspace*{-\PosterRightContentRaise}%
        \fi
        {\centering\PosterTitleFont\color{white}\PosterTitle\par}%
        \PosterHeaderTextGap{\PosterTitleAuthorGap}%
        {\centering\PosterPresenterFont\color{white}\underline{\PosterPresenter}\par}%
        \PosterHeaderTextGap{\PosterAuthorGap}%
        {\centering\PosterCoauthorFont\color{white}\textbf{Collaboration with:}\space\PosterCoauthors\par}%
        \PosterHeaderTextGap{\PosterAffiliationGap}%
        {\centering\PosterAffiliationFont\color{white}\PosterAffiliations\par}%
      \end{minipage}%
    \end{column}
  \end{columns}%
  % The tikzpicture itself is kept in both states to preserve baseline
  % geometry; hiding the reference shifts the body by exactly the strip height.
  \begin{tikzpicture}[remember picture,overlay]%
    \ifPosterShowReference
      \node[anchor=center,inner sep=0pt,text=PosterAccent] at
        ([yshift=-\PosterFeaturedPaperCenterDepth]current page.north) {%
        \parbox{\dimexpr\paperwidth-2\PosterMargin\relax}{%
          \centering\PosterFeaturedPaperFont
          \PosterFeaturedPaperLabel\space\postercitebare{\PosterFeaturedPaperKey}.\par}%
      };%
    \fi
  \end{tikzpicture}%
  \ifPosterShowReference
    \vspace{\dimexpr\PosterHeaderBandHeight-\PosterHeaderTopInset-\PosterHeaderContentHeight+\PosterHeaderGap\relax}%
  \else
    \vspace{\dimexpr\PosterHeaderMainHeight-\PosterHeaderTopInset-\PosterHeaderContentHeight+\PosterHeaderGap\relax}%
  \fi
}

% Fixed footer band. Body remains independent of footer placement.
\newcommand{\PosterFooter}{%
  \begin{tikzpicture}[remember picture,overlay]%
    \fill[PosterAccent] (current page.south west) rectangle
      ([yshift=\PosterFooterBandHeight]current page.south east);%
    \node[anchor=south west,inner sep=0pt] at
      ([xshift=\PosterMargin,yshift=8mm]current page.south west) {%
      \begin{minipage}{\dimexpr\paperwidth-2\PosterMargin\relax}%
        {\PosterFooterFont\color{white}%
          \PosterConference\quad\textbar\quad\PosterVenue\quad\textbar\quad\PosterDate
          \hfill\PosterContact\par}%
      \end{minipage}%
    };%
  \end{tikzpicture}%
}

% ---- Generic illustration placeholder; replace it with a real figure ----
\newcommand{\PosterFigurePlaceholder}[1]{%
  \par\vspace{3mm}
  \noindent\fcolorbox{PosterRule}{PosterFigurePale}{%
    \parbox[c][145mm][c]{\dimexpr0.91\linewidth-2\fboxsep-2\fboxrule\relax}{%
      \centering\PosterPlaceholderFont\color{PosterMuted}#1%
    }%
  }%
  \par\vspace{5mm}
}
